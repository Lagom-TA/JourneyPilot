    "command": "npx",
    "args": [
      "-y",
      "tavily-mcp@0.2.21"
    ],
    "env": {
      "TAVILY_API_KEY": "env-TAVILY_API_KEY"
    },
    "sse_url": null,
    "disabled": false,
    "description": "Tavily agent 原生检索（搜索/提取/爬取，返回带引用结果，https://tavily.com）",
    "required_env": [
      "TAVILY_API_KEY"
    ],
    "min_interval_seconds": 0.0
  },
