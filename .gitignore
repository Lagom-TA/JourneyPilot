# JourneyPilot 仓库边界。只写这个仓库会生成的路径。

# 本地配置与密钥。示例文件可以入库。
config.yaml
config.md
.env
.env.local
.env.development
.env.production
.env.test
!.env.example
api_keys.json
api_keys.yaml
secrets.json
secrets.yaml
credentials.json
credentials.yaml
cookies.json
otel-collector-config.yaml

# Python
.venv/
__pycache__/
*.py[cod]
*.so
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.uv-cache/

# Node 与前端构建
node_modules/
dist/
*.tsbuildinfo
.npm-cache/
.eslintcache

# 本地运行产物。output/ 会命中任意同名目录，所以把研究输出的源码包加回来。
*.log
*.log.*
logs/
frontend/logs/
backend/mcp/logs/
test-results/
frontend/test-results/
output/
outputs/
!/backend/travel_agent/planning/research/output/
!/backend/travel_agent/planning/research/output/**
/backend/travel_agent/planning/research/output/**/__pycache__/
/backend/travel_agent/planning/research/output/**/*.py[cod]
out/
temp/
tmp/
cache/
backups/
uploads/
dump.rdb

# 数据库与本地知识库。出厂语料随仓库发布，backend/data 的其余内容不发布。
*.db
*.sqlite
*.sqlite3
*.db-journal
data/
!backend/data/
backend/data/*
!backend/data/corpus/
backend/data/corpus/*
!backend/data/corpus/factory/
!backend/data/corpus/factory/**

# 仓库根目录的临时测试脚本。正式测试在 backend/tests。
test_*.py
*_test.py
test_output/
!backend/tests/
!backend/tests/**
backend/tests/**/__pycache__/
backend/tests/**/*.py[cod]
backend/tests/**/.DS_Store

# API 提供的前端构建结果，由本地构建生成。
/backend/static/

# 模型权重与按需下载的浏览器驱动
*.model
*.pkl
*.pickle
*.safetensors
*.bin
*.ckpt
*.pt
/models/
chromedriver/

# 编辑器与系统文件
.DS_Store
.idea/
.vscode/
*.code-workspace
.cursor/
.zcode/
.claude/settings.local.json
.claude/worktrees/

# 本地审查输出，不随仓库发布
/docs/audits/
